# ── 온비드 OpenAPI (공공데이터포털) ─────────────────────────────
# 마이페이지 > 오픈API > 개발계정 에서 확인하는 "일반 인증키"
#
# 포털이 Encoding / Decoding 두 가지로 보여주더라도 실제로는 같은 키의 두 표현이다.
# 둘 중 아무거나 하나만 넣으면 된다 (코드에서 unquote로 정규화한 뒤 params= 로 전달).
#   Decoding(원본) : A-Za-z0-9 와 +  /  =
#   Encoding       : 위를 URL 인코딩 — %2B  %2F  %3D
ONBID_SERVICE_KEY=

# ── 카카오 로컬 REST API (지오코딩) ─────────────────────────────
# 무료 쿼터 보유 앱 1288016 의 REST API 키 — 서버 전용, 절대 노출 금지
# 주의: 지도 SDK용 JavaScript 키가 아니라 REST API 키여야 한다
KAKAO_REST_API_KEY=

# ── VWorld (지오코딩 폴백 4단계) ────────────────────────────────
# M4에서 카카오만으로 ok 90% 미달일 때만 발급 (그전까지 비워둬도 무방)
VWORLD_API_KEY=

# ── Supabase (적재 대상 DB) ────────────────────────────────────
# ⚠️ krx-stock-charts · krx-signal-alerts · utube-trend-tracer 와 같은 프로젝트를 공유한다.
#    anon 키는 프로젝트 단위이므로 onbid_* 테이블은 RLS로 전면 차단한다 (SPEC §6.6).
# SERVICE_KEY 는 RLS를 우회한다 — 서버 전용, 절대 클라이언트 노출 금지.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DATABASE_URL=

# ── 로컬 설정 ──────────────────────────────────────────────────
ONBID_LOG_LEVEL=INFO
